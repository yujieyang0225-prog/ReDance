<mujoco model="seated_rehab_avatar">
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.01" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.25 0.25 0.25"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.88 0.88 0.88" rgb2="0.72 0.72 0.72"/>
    <material name="floor_mat" texture="grid" texrepeat="6 6"/>
    <material name="body" rgba="0.82 0.52 0.24 1"/>
    <material name="body_dark" rgba="0.60 0.34 0.14 1"/>
    <material name="chair" rgba="0.18 0.20 0.23 1"/>
    <material name="chair_pad" rgba="0.08 0.14 0.20 1"/>
    <material name="imu_blue" rgba="0.00 0.65 1.00 1"/>
    <material name="target_green" rgba="0.10 0.65 0.35 1"/>
    
  </asset>

  <worldbody>
    <light name="key_light" pos="0 -4 4" dir="0 1 -1" diffuse="1 1 1"/>
    <light name="fill_light" pos="-3 2 3" dir="1 -1 -1" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="floor_mat"/>

    <camera name="front_view" pos="0 -3.2 1.35" xyaxes="1 0 0 0 0 1"/>
    <camera name="side_view" pos="3.2 0 1.35" xyaxes="0 1 0 0 0 1"/>

    <body name="chair" pos="0 0 0.45">
      <geom name="seat" type="box" size="0.48 0.40 0.06" material="chair"/>
      <geom name="seat_pad" pos="0 0 0.07" type="box" size="0.44 0.36 0.045" material="chair_pad"/>
      <geom name="backrest" pos="0 0.34 0.42" type="box" size="0.45 0.055 0.45" material="chair_pad"/>
      <geom name="front_left_leg" pos="-0.36 -0.28 -0.24" type="box" size="0.035 0.035 0.25" material="chair"/>
      <geom name="front_right_leg" pos="0.36 -0.28 -0.24" type="box" size="0.035 0.035 0.25" material="chair"/>
      <geom name="back_left_leg" pos="-0.36 0.28 -0.24" type="box" size="0.035 0.035 0.25" material="chair"/>
      <geom name="back_right_leg" pos="0.36 0.28 -0.24" type="box" size="0.035 0.035 0.25" material="chair"/>
    </body>

    <body name="pelvis" pos="0 -0.06 0.64">
      <geom name="pelvis_geom" type="capsule" fromto="-0.19 0 0 0.19 0 0" size="0.075" material="body_dark"/>

      <body name="left_thigh" pos="-0.15 -0.02 -0.02">
        <joint name="left_hip_lift" type="hinge" axis="1 0 0" range="-65 25" damping="2"/>
        <geom name="left_thigh_geom" type="capsule" fromto="0 0 0 0 -0.45 -0.08" size="0.055" material="body"/>
        <geom name="left_thigh_imu_sensor" type="box" pos="0 -0.18 0.03" size="0.040 0.012 0.030" material="imu_blue"/>

        <body name="left_knee" pos="0 -0.45 -0.08">
          <geom name="left_knee_ball" type="sphere" size="0.065" material="body_dark"/>
          <body name="left_shin" pos="0 0 0">
            <geom name="left_shin_geom" type="capsule" fromto="0 0 0 0 -0.04 -0.43" size="0.050" material="body"/>
            <geom name="left_foot" type="sphere" pos="0 -0.12 -0.47" size="0.070"  material="body_dark"/>
          </body>
        </body>
      </body>

      <body name="right_thigh" pos="0.15 -0.02 -0.02">
        <joint name="right_hip_lift" type="hinge" axis="1 0 0" range="-65 25" damping="2"/>
        <geom name="right_thigh_geom" type="capsule" fromto="0 0 0 0 -0.45 -0.08" size="0.055" material="body"/>
        <geom name="right_thigh_imu_sensor" type="box" pos="0 -0.18 0.03" size="0.040 0.012 0.030" material="imu_blue"/>

        <body name="right_knee" pos="0 -0.45 -0.08">
          <geom name="right_knee_ball" type="sphere" size="0.065" material="body_dark"/>
          <body name="right_shin" pos="0 0 0">
            <geom name="right_shin_geom" type="capsule" fromto="0 0 0 0 -0.04 -0.43" size="0.050" material="body"/>
            <geom name="right_foot" type="sphere" pos="0 -0.12 -0.47" size="0.070"  material="body_dark"/>
          </body>
        </body>
      </body>

      <body name="torso" pos="0 0 0.08">
        <joint name="torso_bend" type="hinge" axis="1 0 0" range="-110 25" damping="2"/>
        <joint name="torso_rotation" type="hinge" axis="0 0 1" range="-45 45" damping="2"/>
        <geom name="lower_torso" type="capsule" fromto="0 0 0.03 0 0 0.27" size="0.115" material="body"/>
        <geom name="upper_torso" type="capsule" fromto="-0.14 0 0.41 0.14 0 0.41" size="0.105" material="body"/>

        <geom name="back_imu_sensor" type="box" pos="0 0.125 0.15" size="0.055 0.014 0.040" material="imu_blue"/>

        <body name="shoulders" pos="0 0 0.50">
          <geom name="shoulder_bar" type="capsule" fromto="-0.34 0 0 0.34 0 0" size="0.050" material="body_dark"/>

        
          <geom name="upper_back_imu_sensor" type="box" pos="0 0.120 -0.099" size="0.055 0.014 0.040" material="imu_blue"/>
          <!-- LEFT ARM DOWN -->
          <body name="left_upper_arm" pos="-0.34 0 0">
            <joint name="left_shoulder" type="hinge" axis="1 0 0" range="-90 90" damping="2"/>
            <geom name="left_upper_arm_geom" type="capsule" fromto="0 0 0 0 0 -0.32" size="0.045" material="body"/>

            <body name="left_elbow" pos="0 0 -0.32">
              <geom name="left_elbow_ball" type="sphere" size="0.050" material="body_dark"/>
              <body name="left_forearm" pos="0 0 0">
                <geom name="left_forearm_geom" type="capsule" fromto="0 0 0 0 0 -0.27" size="0.040" material="body"/>
                <geom name="left_hand" type="sphere" pos="0 0 -0.30" size="0.052" material="body_dark"/>
              </body>
            </body>
          </body>

          <!-- RIGHT ARM DOWN -->
          <body name="right_upper_arm" pos="0.34 0 0">
            <joint name="right_shoulder" type="hinge" axis="1 0 0" range="-90 90" damping="2"/>
            <geom name="right_upper_arm_geom" type="capsule" fromto="0 0 0 0 0 -0.32" size="0.045" material="body"/>

            <body name="right_elbow" pos="0 0 -0.32">
              <geom name="right_elbow_ball" type="sphere" size="0.050" material="body_dark"/>
              <body name="right_forearm" pos="0 0 0">
                <geom name="right_forearm_geom" type="capsule" fromto="0 0 0 0 0 -0.27" size="0.040" material="body"/>
                <geom name="right_hand" type="sphere" pos="0 0 -0.30" size="0.052" material="body_dark"/>
              </body>
            </body>
          </body>
        </body>

        <body name="head" pos="0 0 0.70">
          <joint name="head_rotation" type="hinge" axis="0 0 1" range="-75 75" damping="1"/>
          <geom name="neck" type="capsule" fromto="0 0 -0.20 0 0 -0.06" size="0.030" material="body_dark"/>
          <geom name="head_geom" type="sphere" pos="0 0 0.07" size="0.135" material="body"/>
        </body>
      </body>
    </body>

    <body name="foot_target" pos="0 -0.95 0.08">
      <geom type="box" size="0.32 0.15 0.08" material="target_green"/>
    </body>
  </worldbody>
</mujoco>
